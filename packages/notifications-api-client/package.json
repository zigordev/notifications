{
  "name": "notifications-api-client",
  "version": "0.0.0",
  "private": true,
  "description": "The typed client of the API of notifications, generated from its OpenAPI file and sent with openapi-fetch",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node ../notifications-client-generator/generate.ts ../../apps/notifications-api/openapi.json src/generated/schema.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "openapi-fetch": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zigordev/dev": "catalog:",
    "@zigordev/otel": "catalog:",
    "@zigordev/test": "catalog:",
    "notifications-api": "workspace:*",
    "notifications-client-generator": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
