    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigordev/notifications.git",
    "directory": "packages/notifications-events"
  }
}
