#RUNTIME
TRUST_PROXY=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

#DATABASE
POSTGRES_PASSWORD=SET_FROM_OPEN_BAO

#KAFKA
KAFKA_BOOTSTRAP_SERVERS=notifications-redpanda:9092
NOTIFICATIONS_EMAIL_TOPIC=notification.email.requested.v1
NOTIFICATIONS_EMAIL_DLT_TOPIC=notification.email.requested.v1.DLT

#SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change-me@example.com
SMTP_FROM=change-me@example.com
SMTP_STARTTLS=true

#OPENBAO
OPENBAO_TOKEN=CHANGE_ME_PROD_OPENBAO_APP_READ_TOKEN

#DEPLOY_IMAGES
API_IMAGE=REQUIRED_SET_BY_DEPLOY
