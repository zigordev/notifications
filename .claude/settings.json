{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "claudeMdExcludes": ["**/shared/.claude/**"],
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm check)",
      "Bash(pnpm check:quick)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm build)",
      "Bash(pnpm test *)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm exec vitest run *)",
      "Bash(pnpm exec zigordev check *)",
      "Bash(pnpm exec zigordev sync)"
    ],
    "ask": [
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo unarchive *)",
      "Bash(gh workflow run *)",
      "Bash(gh workflow enable *)",
      "Bash(gh workflow disable *)",
      "Bash(gh run rerun *)",
      "Bash(gh release create *)",
      "Bash(gh release edit *)",
      "Bash(gh release delete *)",
      "Bash(gh label create *)",
      "Bash(gh label edit *)",
      "Bash(gh label delete *)",
      "Bash(tofu apply *)",
      "Bash(tofu destroy *)",
      "Bash(tofu import *)",
      "Bash(tofu state rm *)",
      "Bash(tofu state mv *)",
      "Bash(tofu state push *)",
      "Bash(pnpm publish *)",
      "Bash(npm publish *)"
    ],
    "deny": [
      "Bash(gh secret set *)",
      "Bash(gh secret delete *)",
      "Bash(gh variable set *)",
      "Bash(gh variable delete *)",
      "Bash(aws * put-parameter*)",
      "Bash(aws * delete-parameter*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.sh"],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.sh"],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
