{
  "name": "notifications-api",
  "version": "0.0.0",
  "private": true,
  "description": "The notifications service: it reads email requests from Kafka, delivers them through SMTP with retries, and answers each request with its outcome",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "src",
    "drizzle",
    "flags.json",
    "producers.json",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "start": "node --import @zigordev/otel/register src/main.ts",
    "dev": "node --env-file=.env.development --watch --import @zigordev/otel/register src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "migrate": "node --env-file=.env.development src/migrate.ts",
    "openapi": "node src/openapi.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "catalog:",
    "@openfeature/server-sdk": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@zigordev/api": "catalog:",
    "@zigordev/config": "catalog:",
    "@zigordev/events": "catalog:",
    "@zigordev/flags": "catalog:",
    "@zigordev/notifications-events": "workspace:*",
    "@zigordev/otel": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "nodemailer": "catalog:",
    "pg": "catalog:shipped",
    "pg-boss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@platformatic/kafka": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "@types/pg": "catalog:",
    "@zigordev/dev": "catalog:",
    "@zigordev/test": "catalog:",
    "drizzle-kit": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
